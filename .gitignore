# Virtual environments
.venv/
venv/
env/
ENV/

# Data directories (raw and processed data must never be committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts and binaries
artifacts/*
!artifacts/.gitkeep

# Secrets and environment configurations
.env
.env.*
*.env

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Test and coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini


